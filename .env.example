# Browser users connect directly to Lisa; Lisa uses this token for scoped
# storage calls to TheLake.
LISA_THELAKE_TOKEN=
LISA_PUBLIC_URL=http://127.0.0.1:18082/v1
THELAKE_LISA_PUBLIC_PORT=18082
LISA_LOCAL_ANONYMOUS=0
LISA_CORS_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
SOFTPROBE_ASSERTION_HMAC_SECRET=
LISA_QA_CRON=0 * * * *
LISA_SLACK_SIGNING_SECRET=
LISA_SLACK_BOT_TOKEN=
LISA_SLACK_TEAM_ID=
LISA_SLACK_ALLOWED_USERS=
LISA_SLACK_ALLOWED_CHANNELS=
LISA_SLACK_CHANNEL_ID=
# The quickstart reads this key from the ignored .env file, or prompts once.
GEMINI_API_KEY=
GOOGLE_API_KEY=
LISA_MODEL=gemini/gemini-2.5-flash
LISA_BASE_URL=
LISA_API_KEY=
