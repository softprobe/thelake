{
  "name": "@softprobe/thelake-explorer",
  "version": "0.1.0",
  "description": "Shared trace and session Explorer for thelake",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.spa.config.ts && tsc -p tsconfig.lib.json",
    "build:embedded": "vite build --config vite.spa.config.ts --mode embedded",
    "build:lisa-frontend": "vite build --config vite.lisa.config.ts",
    "dev:spa": "vite --config vite.spa.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.28",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
